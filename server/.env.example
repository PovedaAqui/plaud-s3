# Where audio, transcripts and notes are stored.
PLAUD_DATA_DIR=./data

# Optional: also copy notes into <dir>/Plaud/ (an Obsidian vault works).
# PLAUD_VAULT_DIR=/mnt/c/Users/Luis/Documents/Luis/Obsidian

# ASR
PLAUD_ASR_MODEL=small
PLAUD_ASR_DEVICE=cpu
PLAUD_ASR_COMPUTE=int8
PLAUD_ASR_BEAM_SIZE=5
PLAUD_ASR_VAD=1
# PLAUD_LANGUAGE=en

# Speaker diarization (optional, needs a Hugging Face token)
PLAUD_DIARIZE=0
# PLAUD_HF_TOKEN=hf_...

# Notes: any OpenAI-compatible endpoint. Ollama default shown.
# Ollama by default; any OpenAI-compatible server works, e.g. llama.cpp serving MiniCPM-V:
# PLAUD_LLM_BASE_URL=http://127.0.0.1:8080/v1
PLAUD_LLM_BASE_URL=http://127.0.0.1:11434/v1
PLAUD_LLM_MODEL=llama3.2
PLAUD_LLM_API_KEY=ollama
PLAUD_LLM_TIMEOUT=8
PLAUD_LLM_MAX_CHARS=24000
PLAUD_LLM_TEMPERATURE=0.2
# 0 = let the endpoint decide
PLAUD_LLM_MAX_TOKENS=0

# Process synchronously on stop (used by tests)
PLAUD_SYNC_PIPELINE=0
